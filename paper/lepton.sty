% lepton.sty: the page layout of the LEPTON paper (PJDSC 2026).
%
% All styling lives here, so the files in sections/ carry text only and can move to another
% template (for example one PJDSC provides) unchanged. Colours and type follow the submitted
% proposal: Montserrat, navy headings, a sage band at the top of every page.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lepton}[2026/10/21 LEPTON paper layout]

% --- Page -------------------------------------------------------------------------------
\RequirePackage[a4paper, top=27mm, bottom=24mm, left=18mm, right=18mm,
  columnsep=7mm, footskip=11mm]{geometry}

% --- Type: Montserrat, as in the proposal; Latin Modern for code-style names ------------
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[defaultfam, tabular, lining]{montserrat}
\DeclareFontSeriesDefault[tt]{md}{m}          % Latin Modern Mono's own weights, not
\DeclareFontSeriesDefault[tt]{bf}{b}          % Montserrat's names for them
\RequirePackage[american]{babel}
\RequirePackage{microtype}
\RequirePackage{csquotes}
\linespread{1.08}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em plus 0.2em}
\setlength{\emergencystretch}{1em}            % fewer loose lines in the narrow columns
\frenchspacing                                % one space after a full stop
\raggedbottom
\hyphenation{XGBoost Prophet IMERG}
\RequirePackage{amsmath}

% --- Colours, sampled from the proposal ------------------------------------------------
\RequirePackage{xcolor}
\definecolor{leptonnavy}{HTML}{1F3C88}        % headings
\definecolor{leptonsage}{HTML}{8AA89B}        % the band at the top of each page
\definecolor{leptonsagedark}{HTML}{4F7A6B}    % small labels and the footer
\definecolor{leptonsagelight}{HTML}{EEF3F0}   % the summary box
\definecolor{leptonsalmon}{HTML}{D9775A}      % the subtitle

% --- Headings: numbered, navy, sections in capitals as in the proposal ----------------
\RequirePackage{titlesec}
\titleformat{\section}{\color{leptonnavy}\normalfont\large\bfseries}{\thesection}{0.6em}{\MakeUppercase}
\titlespacing*{\section}{0pt}{1.3em}{0.3em}
\titleformat{\subsection}{\color{leptonnavy}\normalfont\normalsize\bfseries}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{0.9em}{0.1em}
\titleformat{\paragraph}[runin]{\color{leptonnavy}\normalfont\normalsize\bfseries}{}{0pt}{}[.]
\titlespacing*{\paragraph}{0pt}{0.5em}{0.5em}

% --- The sage band at the top of every page, as in the proposal ----------------------
% Put the PJDSC logo at figures/pjdsc-logo.png (white, on a clear background) and it
% replaces the words.
\RequirePackage{graphicx}
\RequirePackage{eso-pic}
\newcommand{\lepton@bandlabel}{%
  \IfFileExists{figures/pjdsc-logo.png}%
    {\includegraphics[height=7mm]{figures/pjdsc-logo.png}}%
    {\color{white}\fontsize{15}{15}\selectfont\bfseries PJDSC 2026}}
\AddToShipoutPictureBG{%
  \AtPageUpperLeft{\color{leptonsage}\rule[-14mm]{\paperwidth}{14mm}}%
  \AtPageUpperLeft{\put(\LenToUnit{18mm},\LenToUnit{-9.6mm}){\lepton@bandlabel}}%
}

% --- Footer -------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\fancypagestyle{lepton}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{\color{leptonsagedark}\footnotesize\bfseries PJDSC 2026 \textperiodcentered\ Project LEPTON}%
  \fancyfoot[R]{\color{leptonsagedark}\footnotesize\thepage}%
}
\pagestyle{lepton}

% --- Title block (used in main.tex) ----------------------------------------------------
\newcommand{\leptonkicker}{\color{leptonsagedark}\footnotesize\bfseries}
\newcommand{\leptontitlefont}{\color{leptonnavy}\fontsize{26}{29}\selectfont\bfseries}
\newcommand{\leptonsubtitlefont}{\color{leptonsalmon}\large\itshape}

% The executive summary box under the title (task E9).
\newsavebox{\lepton@summarybox}
\newenvironment{leptonsummary}
  {\par\noindent\setlength{\fboxsep}{4mm}%
   \begin{lrbox}{\lepton@summarybox}%
   \begin{minipage}{\dimexpr\textwidth-2\fboxsep-2\fboxrule\relax}}
  {\end{minipage}\end{lrbox}%
   \fcolorbox{leptonsagedark}{leptonsagelight}{\usebox{\lepton@summarybox}}\par}

% --- Lists and tables ------------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{itemsep=0.15em, topsep=0.3em, parsep=0pt, leftmargin=1.2em}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{caption}
\captionsetup{font=small, labelfont={bf, color=leptonnavy}, labelsep=period, skip=4pt}
% A config.py name under a table entry, e.g. \cfg{DELAY_GUARD_G} (no escaping needed).
\newcommand{\cfg}[1]{\par{\scriptsize\ttfamily\detokenize{#1}}}

% --- Notes for the team ----------------------------------------------------------------
% \checkme{...} marks a claim a teammate must confirm or a result still to come. It prints
% in red on purpose: none may be left at the final read-through (task E11).
\newcommand{\checkme}[1]{\textcolor{red}{\textbf{[Check:} #1\textbf{]}}}

% --- Appendices: "Appendix A. Title", tables numbered A1, A2, ... (\appendix in main.tex) --
\g@addto@macro\appendix{%
  \titleformat{\section}{\color{leptonnavy}\normalfont\large\bfseries}{Appendix \thesection.}{0.5em}{}%
  \counterwithin*{table}{section}%
  \renewcommand{\thetable}{\thesection\arabic{table}}%
  \counterwithin*{figure}{section}%
  \renewcommand{\thefigure}{\thesection\arabic{figure}}%
}

% --- References: APA 7th edition (biblatex-apa, run with Biber) -------------------------
\RequirePackage[style=apa, backend=biber]{biblatex}
\AtBeginBibliography{\raggedright}            % APA sets references flush left
\RequirePackage{xurl}
\RequirePackage[colorlinks, linkcolor=leptonnavy, citecolor=leptonnavy,
  urlcolor=leptonnavy]{hyperref}

\endinput
